{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aristocks-calculator",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "FUTURES_CACHE"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
